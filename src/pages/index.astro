---
import SiteChrome from "../layouts/SiteChrome.astro";
import Container from "../components/Container.astro";
import Heading from "../components/Heading.svelte";
import HomepageProjectList from "../components/HomepageProjectList.astro";
import { getHomepageProjectEntries } from "../lib/projectContent";
import { createHomepageJsonLd, SITE_URL } from "../lib/seo";

const projects = await getHomepageProjectEntries();
const pageTitle = "Invisible Sloth | Tracer, Games & Developer Tools";
const pageDescription =
	"Invisible Sloth creates Tracer, a private iPhone time tracker, the Roxy Playdate game engine, and Drawing Zoo, a collaborative board game.";
const jsonLd = createHomepageJsonLd();
---

<SiteChrome
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={SITE_URL}
	jsonLd={jsonLd}
>
	<main class="site-main">
		<section class="section">
			<Container padded={false} size="md" class="stack">
				<div class="measure--content spacing-outer-inline text-center">
					<Heading level="h1" text={"What’s up at Invisible\u00A0Sloth?"} />
				</div>

				<HomepageProjectList projects={projects} />
			</Container>
		</section>
	</main>
</SiteChrome>
