---
import SiteChrome from "../../layouts/SiteChrome.astro";
import Container from "../../components/Container.astro";
import Figure from "../../components/Figure.svelte";
import PageHeader from "../../components/PageHeader.svelte";
import RichTextBlock from "../../components/RichTextBlock.svelte";
import ProductStatus from "../../components/ProductStatus.svelte";
import ContentSection from "../../components/ContentSection.svelte";
import ProductSupport from "../../components/ProductSupport.svelte";
import type { ProductSupportDocumentLink } from "../../components/ProductSupport.svelte";
import { TRACER_PRODUCT_STATUS } from "../../lib/tracerProductStatus";
import { createTracerJsonLd, TRACER_URL } from "../../lib/seo";

const pageTitle = "Tracer: Personal Time Tracker for iPhone | Invisible Sloth";
const pageDescription =
  "Keep a clear record of your time with Tracer for iPhone. Track projects, hobbies, work, and everyday life. No sign-up or subscription.";
const jsonLd = createTracerJsonLd(pageTitle, pageDescription);

const tracerScreenshotSize = { width: 1680, height: 1120 };
const tracerScreenshots = {
  tracker: {
    src: "/assets/tracer-running-tracker.png",
    alt: "Tracer’s running tracker with controls to stop and save or start the next activity.",
  },
  editEntry: {
    src: "/assets/tracer-edit-entry.png",
    alt: "Tracer’s Edit Entry screen showing the activity, start and end times, and a note.",
  },
  report: {
    src: "/assets/tracer-time-reports.png",
    alt: "Tracer Reports showing daily and weekly charts and time totals by activity.",
  },
  plusActivities: {
    src: "/assets/tracer-plus-activity-list.png",
    alt: "Tracer’s Activities list with more than three activities ready to track.",
  },
  settings: {
    src: "/assets/tracer-data-and-backups-settings.png",
    alt: "The Your Data section of Tracer Settings showing Export Backup, Export CSV for Tracer Plus, and Import Backup.",
  },
};

const supportDocuments: ProductSupportDocumentLink[] = [
  {
    label: "Tracer App Privacy Policy",
    href: "/tracer/privacy/",
  },
  {
    label: "Tracer App License Information",
    href: "/tracer/terms/",
  },
];
---

<SiteChrome
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={TRACER_URL}
  jsonLd={jsonLd}
  activeHref="/tracer"
>
  <main class="site-main tracer-page">
    <section class="tracer-page__section">
      <PageHeader
        title="Tracer"
        excerpt="Keep a clear record of your time. No sign-up or subscription required."
      />

      <Container size="sm" class="tracer-page__content-group">
        <RichTextBlock>
          <p>
            Tracer is a personal time tracker for iPhone. Track projects, hobbies, work, and
            everyday life, and see how you spend your time. Tracer tracks one activity at a time,
            by design. Your records stay on your iPhone. The app has no servers, ads, or
            third-party analytics.
          </p>
        </RichTextBlock>
      </Container>

      <Container size="md" class="tracer-page__content-group">
        <ProductStatus {...TRACER_PRODUCT_STATUS} />
      </Container>

      <Container size="sm" class="tracer-page__content-group">
        <ContentSection heading="Use Tracer Free" headingLevel="h2" bodyMode="structured">
          <ul class="tracer-page__free-features" role="list">
            <li class="tracer-page__illustrated-feature">
              <div class="tracer-page__feature-copy">
                <strong class="text-title-medium-prominent">Start, switch, and save in one step.</strong>
                <p class="text-body-responsive-tight">
                  Start tracking. When you’re done, stop and save, or save and start the next
                  activity together.
                </p>
              </div>
              <Figure imageProps={{ ...tracerScreenshots.tracker, ...tracerScreenshotSize }} />
            </li>
            <li class="tracer-page__illustrated-feature">
              <div class="tracer-page__feature-copy">
                <strong class="text-title-medium-prominent">Make changes whenever you need.</strong>
                <p class="text-body-responsive-tight">
                  Change the activity or start time while tracking. Add or edit entries manually,
                  and add notes to activities and entries.
                </p>
              </div>
              <Figure imageProps={{ ...tracerScreenshots.editEntry, ...tracerScreenshotSize }} />
            </li>
            <li class="tracer-page__illustrated-feature">
              <div class="tracer-page__feature-copy">
                <strong class="text-title-medium-prominent">See how you spend your time.</strong>
                <p class="text-body-responsive-tight">
                  Browse your history, explore daily and weekly charts, and see totals for today,
                  this week, this month, and more.
                </p>
              </div>
              <Figure imageProps={{ ...tracerScreenshots.report, ...tracerScreenshotSize }} />
            </li>
            <li>
              <strong class="text-title-medium-prominent">Keep the activities you need ready to track.</strong>
              <p class="text-body-responsive-tight">
                Give each activity its own color. On Tracer Free, you can create or restore an
                activity when you have fewer than three in your list. Archive activities to make
                room without losing their history.
              </p>
            </li>
            <li>
              <strong class="text-title-medium-prominent">Keep a backup of your records.</strong>
              <p class="text-body-responsive-tight">
                Export a JSON backup and import it when you need to restore your records.
                See <a class="text-link" href="#data-and-backups"><strong>Data and Backups</strong></a>
                for details.
              </p>
            </li>
          </ul>
        </ContentSection>
      </Container>

      <Container size="sm" class="tracer-page__content-group">
        <ContentSection heading="Tracer Plus" headingLevel="h2" bodyMode="prose">
          <p>
            An optional one-time purchase lets you keep as many activities in your list as you
            like, and adds CSV export for spreadsheets. Your purchase also includes every Tracer Plus
            feature we add in the future. Tracer Plus supports Family Sharing. Each person’s records
            stay separate.
          </p>
        </ContentSection>
        <Figure
          class="tracer-page__plus-figure"
          imageProps={{ ...tracerScreenshots.plusActivities, ...tracerScreenshotSize }}
          captionText="With Plus, your list can hold as many activities as you want. The timer still runs one at a time."
        />
      </Container>

      <section id="support" class="tracer-page__support">
        <div class="tracer-page__support-rail">
          <ProductSupport
            heading="Support"
            emailPrompt="For feedback, bug reports, or questions, email"
            supportEmail="support@invisiblesloth.com"
            supportDetails={[
              "Tracer stores data on your device, so Invisible Sloth does not have access to your activities, entries, notes, or backups unless you choose to send them.",
              "We are a small team, so we may not be able to reply to every email, but we do our best to read them all. Thank you for understanding.",
            ]}
            documentsHeading="Tracer App Documents"
            documents={supportDocuments}
          >
            <ContentSection
              id="data-and-backups"
              heading="Data and Backups"
              headingLevel="h3"
              visualLevel="h4"
              bodyMode="prose"
            >
              <p>
                Your records are stored on your iPhone. Tracer has no account, cloud sync, or
                automatic backup service. Invisible Sloth does not keep a recovery copy.
                Apple-managed device backups may include Tracer data, depending on your device
                settings.
              </p>
              <p>In Tracer, find these options under <strong>Settings → Your Data</strong>.</p>
              <Figure imageProps={{ ...tracerScreenshots.settings, ...tracerScreenshotSize }} />
              <ul>
                <li>
                  <strong>Export Backup</strong> creates a JSON file. Use the iOS share sheet
                  to save it somewhere you can reach from another device, such as iCloud Drive.
                  Confirm the file is there and keep it.
                </li>
                <li>
                  <strong>Export CSV</strong> requires Tracer Plus and creates a file for
                  spreadsheets. CSV files can’t restore your Tracer records.
                </li>
                <li>
                  <strong>Import Backup</strong> restores records from a saved JSON backup. When
                  you confirm <strong>Replace All Data</strong>, Tracer replaces all current
                  activities and entries with the records in that backup. It does not merge them.
                  Save a current JSON backup before importing.
                </li>
              </ul>
              <p>
                <strong>Restore Purchases</strong> is on the Tracer Plus screen in Settings. It
                restores access to Tracer Plus. To restore your records, use <strong>Import Backup</strong>
                with a saved JSON backup.
              </p>
            </ContentSection>
          </ProductSupport>
        </div>
      </section>
    </section>
  </main>
</SiteChrome>

<style>
  .tracer-page__section {
    padding-block-start: var(--space-section-block);
  }

  :global(.tracer-page .tracer-page__content-group) {
    padding-block-end: var(--space-section-block);
  }

  .tracer-page__free-features {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tracer-page__free-features > li,
  .tracer-page__feature-copy {
    display: grid;
    gap: var(--space-100);
  }

  .tracer-page__free-features p {
    margin: 0;
  }

  .tracer-page__free-features > .tracer-page__illustrated-feature {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-gutter);
  }

  :global(.tracer-page .tracer-page__plus-figure) {
    margin-block-start: var(--space-gutter);
  }

  @media (min-width: 1015px) {
    .tracer-page__free-features > li > strong,
    .tracer-page__feature-copy > strong {
      font-family: var(--typography-title-large-family);
      font-size: var(--typography-title-large-size);
      font-weight: var(--typography-title-large-weight-prominent);
      line-height: var(--typography-title-large-line-height);
      letter-spacing: var(--typography-title-large-letter-spacing);
    }
  }

  .tracer-page__support {
    padding-block-end: var(--space-section-block);
  }

  .tracer-page__support-rail {
    box-sizing: border-box;
    inline-size: 100%;
    margin-inline: auto;
  }

  @media (min-width: 632px) {
    .tracer-page__support-rail {
      padding-inline: var(--space-rail-inline);
    }
  }

  @media (min-width: 1176px) {
    :global(.tracer-page .tracer-page__content-group) {
      padding-inline: 0;
    }

    .tracer-page__support-rail {
      max-inline-size: var(--size-rail-md);
      padding-inline: 0;
    }
  }
</style>
